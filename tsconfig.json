{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "temporal-polyfill/types/global"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
