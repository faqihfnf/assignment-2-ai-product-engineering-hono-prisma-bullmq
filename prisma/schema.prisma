// use prisma-next

// One row per request submitted to POST /jobs.
// status: QUEUED -> PROCESSING -> COMPLETED | FAILED
model StudyJob {
  id         String      @id @default(uuid())
  topic      String
  level      String
  material   String?
  status     String
  step       String?
  attempts   Int         @default(0)
  error      String?
  createdAt  DateTime    @default(now())
  finishedAt DateTime?
  guide      StudyGuide?
}

// The final AI output. Only exists once the pipeline has finished successfully.
model StudyGuide {
  id         String   @id @default(uuid())
  jobId      String   @unique
  job        StudyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title      String
  overview   String
  objectives Json
  concepts   Json
  quiz       Json
  createdAt  DateTime @default(now())
}
