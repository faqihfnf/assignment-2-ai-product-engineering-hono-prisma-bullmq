# API port
PORT=3000

# PostgreSQL from docker-compose.yml
DATABASE_URL="postgresql://studyguide:studyguide@localhost:55432/studyguide"

# Redis from docker-compose.yml (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6380

# OpenAI-compatible provider used by anvia (@anvia/openai) in the worker
OPENAI_API_KEY="your-api-key"
# OPENAI_BASE_URL="https://your-provider.example/v1"
OPENAI_MODEL="gpt-5.6-luna"
